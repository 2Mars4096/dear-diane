# Minimal Dear Diane configuration. Copy to .env.

# OpenAI or OpenAI-compatible provider
DIANE_LLM_API_KEY=your-api-key-here
DIANE_LLM_BASE_URL=https://api.openai.com/v1
DIANE_LLM_MODEL=gpt-5.4

# Optional workspace/state roots
# DIANE_WORKSPACE_ROOT=/absolute/path/to/workspace
# DIANE_GRAPHS_DIR=/absolute/path/to/durable-state
# DIANE_NOTES_WORKSPACE_ROOT=/absolute/path/to/notes

# Native-provider alternatives
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
