{
  "name": "3-Step Chain: Research -> Analyze -> Summarize",
  "description": "Legacy pre-dan_graph_v1 sequential workflow sample",
  "version": "1.0.0",
  "nodes": [
    {
      "id": "input_topic",
      "type": "input",
      "name": "Topic Input",
      "description": "Enter the research topic",
      "config": {
        "variable_name": "topic",
        "type": "string",
        "required": true,
        "placeholder": "e.g., Artificial Intelligence in Healthcare"
      },
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "research_step",
      "type": "tool",
      "name": "Research",
      "description": "Search for information on the topic",
      "tool": "web_search",
      "config": {
        "query": "{{topic}}",
        "num_results": 5,
        "fetch_content": true
      },
      "inputs": {
        "query": {
          "from": "input_topic",
          "variable": "topic"
        }
      },
      "outputs": {
        "research_data": "search_results"
      },
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "analysis_step",
      "type": "code",
      "name": "Analysis",
      "description": "Analyze and extract insights from research data",
      "code": "findings = research_data if isinstance(research_data, list) else []\nanalysis_results = {'source_count': len(findings)}\nprint('Analysis complete')",
      "inputs": {
        "research_data": {
          "from": "research_step",
          "variable": "search_results"
        }
      },
      "outputs": {
        "analysis_results": "analysis_results"
      },
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "summary_step",
      "type": "code",
      "name": "Summarize",
      "description": "Generate final markdown summary",
      "code": "final_summary = f'# Summary\\n\\nTopic: {topic}'\nprint('Summary generated')",
      "inputs": {
        "topic": {
          "from": "input_topic",
          "variable": "topic"
        },
        "analysis_results": {
          "from": "analysis_step",
          "variable": "analysis_results"
        }
      },
      "outputs": {
        "final_summary": "final_summary"
      },
      "position": {
        "x": 100,
        "y": 550
      }
    },
    {
      "id": "output_summary",
      "type": "output",
      "name": "Final Output",
      "description": "Markdown summary report",
      "config": {
        "format": "markdown",
        "filename": "research_summary.md"
      },
      "inputs": {
        "content": {
          "from": "summary_step",
          "variable": "final_summary"
        }
      },
      "position": {
        "x": 100,
        "y": 700
      }
    }
  ],
  "edges": [
    {
      "from": "input_topic",
      "to": "research_step"
    },
    {
      "from": "research_step",
      "to": "analysis_step"
    },
    {
      "from": "input_topic",
      "to": "summary_step"
    },
    {
      "from": "analysis_step",
      "to": "summary_step"
    },
    {
      "from": "summary_step",
      "to": "output_summary"
    }
  ],
  "inputs": [
    {
      "name": "topic",
      "type": "string",
      "description": "Research topic to investigate",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "final_summary",
      "type": "string",
      "description": "Markdown formatted research summary"
    }
  ],
  "metadata": {
    "author": "DAN Workflow Builder",
    "category": "Research",
    "tags": [
      "research",
      "analysis",
      "summary",
      "chain"
    ],
    "created": "2026-03-18",
    "updated": "2026-03-18"
  }
}
