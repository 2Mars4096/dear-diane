{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["intent", "family", "variant", "expected"],
  "properties": {
    "intent": { "type": "string", "description": "Natural language goal" },
    "family": {
      "type": "string",
      "enum": ["paper_writing", "rag_qa", "multi_step_analysis", "review_loop", "fan_out_fan_in"]
    },
    "variant": {
      "type": "string",
      "enum": ["simple", "standard", "complex"]
    },
    "expected": {
      "type": "object",
      "required": ["min_nodes", "node_types", "topology"],
      "properties": {
        "min_nodes": { "type": "integer", "minimum": 1 },
        "node_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "topology": {
          "type": "object",
          "properties": {
            "has_loops": { "type": "boolean" },
            "has_fan_out": { "type": "boolean" },
            "has_tools": { "type": "boolean" },
            "has_human_in_loop": { "type": "boolean" },
            "has_rag": { "type": "boolean" }
          }
        },
        "required_ports": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Port names that must exist"
        }
      }
    },
    "edge_case": { "type": "boolean", "default": false },
    "notes": { "type": "string" }
  }
}
