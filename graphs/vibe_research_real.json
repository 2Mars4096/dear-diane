      "retry_policy": null,
      "node_type": "code_operator",
      "code": "# Summarize quintile results (code-only so demo runs without LLM API)\nif isinstance(results, dict) and \"quintiles\" in results:\n    results = results[\"quintiles\"]\nquintile_list = results if isinstance(results, list) else []\nif not quintile_list:\n    result = {\"text\": \"No quintile results to summarize.\"}\nelse:\n    parts = []\n    for r in quintile_list:\n        qnum = r.get(\"quintile\", r.get(\"quintile_num\", \"?\"))\n        avg = r.get(\"avg_return_bps\", 0)\n        nstocks = r.get(\"n_stocks\", 0)\n        parts.append(\"Q\" + str(qnum) + \": \" + str(round(avg, 1)) + \" bps (n=\" + str(nstocks) + \")\")\n    spread = \"\"\n    if len(parts) >= 2:\n        first = quintile_list[0].get(\"avg_return_bps\", 0) if isinstance(quintile_list[0], dict) else 0\n        last = quintile_list[-1].get(\"avg_return_bps\", 0) if isinstance(quintile_list[-1], dict) else 0\n        spread = \" Spread Q1-Q5: \" + str(round(last - first, 1)) + \" bps.\"\n    result = {\"text\": \"Factor portfolio results: \" + \"; \".join(parts) + \".\" + spread + \" (Mock data for demo.)\"}",
      "language": "python",
      "sandbox_config": {}
    },
