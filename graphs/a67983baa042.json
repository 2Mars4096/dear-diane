      "node_type": "code_operator",
      "code": "\nimport csv\nimport os\n\n# Read the watchlist CSV file\nwatchlist_path = input_path\nprint(f\"Reading watchlist from: {watchlist_path}\")\n\nif not os.path.exists(watchlist_path):\n    raise FileNotFoundError(f\"Watchlist file not found: {watchlist_path}\")\n\ntickers = []\nwith open(watchlist_path, 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        ticker = row.get('ticker', '').strip().upper()\n        if ticker:\n            tickers.append(ticker)\n\nprint(f\"Loaded {len(tickers)} tickers: {tickers}\")\nresult = tickers\n",
      "language": "python",
