          },
          "ui": {},
          "metadata": {
            "source": {
              "file": "/Users/lizhi/Dropbox/Projects/deep-agent-network/examples/vibe_research_md/compute_factor.md",
              "line": 1
            }
          },
          "retry_policy": null,
          "node_type": "code_operator",
          "code": "# Build factor and assign quintiles (1-5)\n# Quintile 1 = lowest factor, Quintile 5 = highest\ndata = data if isinstance(data, dict) else {}\nreturns = data.get(\"returns\", []) if isinstance(data.get(\"returns\"), list) else []\nfactor_raw = data.get(\"factor_raw\", []) if isinstance(data.get(\"factor_raw\"), list) else []\n\nn = min(len(returns), len(factor_raw))\nif n == 0:\n    result = {\"quintiles\": []}\nelse:\n    # Sort by factor, assign quintile\n    paired = list(zip(factor_raw[:n], returns[:n]))\n    paired.sort(key=lambda x: x[0])\n    q_size = max(1, n // 5)\n    quintiles = []\n    for i in range(5):\n        start = i * q_size\n        end = (i + 1) * q_size if i < 4 else n\n        q_returns = [r for _, r in paired[start:end]]\n        q_avg = sum(q_returns) / len(q_returns) if q_returns else 0\n        quintiles.append({\"quintile\": i + 1, \"avg_return_bps\": round(q_avg, 2), \"n_stocks\": len(q_returns)})\n    result = {\"quintiles\": quintiles}",
          "language": "python",
          "sandbox_config": {}
        },
