          "retry_policy": null,
          "node_type": "code_operator",
          "code": "# Mock data loader: synthetic returns and factor data for demo\n# In production, swap with CRSP/Compustat or your data source\n# Deterministic LCG (no import) for reproducibility\ndef _lcg(seed, n):\n    a, c, m = 1103515245, 12345, 2**31\n    out = []\n    for _ in range(n):\n        seed = (a * seed + c) % m\n        out.append((seed / m - 0.5) * 2)\n    return out\nseed = 42  # deterministic for demo\nn_obs = 60\nreturns = [_lcg(seed + i, 1)[0] * 50 + 2 for i in range(n_obs)]\nfactor_raw = _lcg(seed + 1000, n_obs)\nresult = {\"data\": {\"returns\": returns, \"factor_raw\": factor_raw}}",
          "language": "python",
          "sandbox_config": {}
        },
        {
          "id": "compute_factor",
          "name": "compute_factor",
          "description": "",
          "input_ports": [
