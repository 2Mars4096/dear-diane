{
  "name": "dan",
  "private": true,
  "version": "0.1.0",
  "description": "DAN Work and Notes desktop client for Universal Organism and Super DAN",
  "author": "DAN",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run ocr:assets && vite",
    "build": "npm run ocr:assets && tsc -b && vite build",
    "bundle:check": "node scripts/check-bundle-budgets.mjs",
    "build:verify": "npm run build && npm run bundle:check",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "electron:compile": "tsc -p electron/tsconfig.json && cp electron/preload.cjs electron/updateInstaller.cjs dist-electron/ && echo '{\"type\":\"commonjs\"}' > dist-electron/package.json && node scripts/write-local-build.cjs",
    "electron:dev": "npm run electron:compile && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && npm run electron:compile",
    "dist": "npm run build && npm run electron:compile && electron-builder",
    "dist:mac": "npm run build && npm run electron:compile && CXXFLAGS=\"-isystem $(xcrun --show-sdk-path)/usr/include/c++/v1\" electron-builder --mac --publish never && codesign --force --deep --sign - release/mac-arm64/DAN.app",
    "dist:win": "npm run build && npm run electron:compile && electron-builder --win",
    "dist:linux": "npm run build && npm run electron:compile && electron-builder --linux",
    "ocr:assets": "node scripts/copy-ocr-assets.mjs"
  },
  "build": {
    "appId": "com.dan.desktop",
    "productName": "DAN",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "resources/icons/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "icon": "resources/icons/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "2Mars4096",
      "repo": "deep-agent-network",
      "private": true
    },
    "extraResources": [
      {
        "from": "build/github-update.yml",
        "to": "app-update.yml"
      }
    ]
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "dompurify": "^3.3.3",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.38",
    "lucide-react": "^0.575.0",
    "marked": "^17.0.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^6.0.1",
    "typescript": "~5.9.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.8.4",
    "tailwindcss": "^4.2.1",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.4"
  }
}
