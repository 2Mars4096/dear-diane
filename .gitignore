build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Type checking / lint caches
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# Python task runners
.tox/
.nox/

# Jupyter
.ipynb_checkpoints/

# Environment files
.env
.env.*
!.env.example

