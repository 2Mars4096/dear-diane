# Dear Diane — retained Universal product configuration
# Copy to .env and uncomment only what you need.

# -----------------------------------------------------------------------------
# Provider
# -----------------------------------------------------------------------------

DIANE_LLM_API_KEY=your-api-key-here
DIANE_LLM_BASE_URL=https://api.openai.com/v1
DIANE_LLM_MODEL=gpt-5.4

# Token usage analyzer (Dear Diane settings): stage classifier on OpenRouter's Decisions endpoint.
# Uses DIANE_OPENROUTER_API_KEY, OPENROUTER_API_KEY, or DIANE_LLM_API_KEY. Default: jev-latest
# DIANE_USAGE_CLASSIFIER_MODEL=jev-latest

# Native-provider keys for matching model prefixes.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# DIANE_ANTHROPIC_API_KEY=
# DIANE_GOOGLE_API_KEY=

# Exact model-to-provider overrides, for example:
# DIANE_MODEL_PROVIDER_MAP={"custom-model":"default","claude-custom":"anthropic"}

# Provider request behavior.
# DIANE_PROVIDER_TIMEOUT=120
# DIANE_LLM_CALL_TIMEOUT=120
# DIANE_PROVIDER_RETRY_MAX_ATTEMPTS=3
# DIANE_PROVIDER_RETRY_INITIAL_DELAY_SECONDS=1
# DIANE_PROVIDER_RETRY_MAX_DELAY_SECONDS=8
# DIANE_OPENAI_COMPAT_REASONING=enabled

# -----------------------------------------------------------------------------
# Workspace and durable state
# -----------------------------------------------------------------------------

# DIANE_WORKSPACE_ROOT=/absolute/path/to/workspace
# DIANE_GRAPHS_DIR=/absolute/path/to/durable-state
# DIANE_NOTES_WORKSPACE_ROOT=/absolute/path/to/notes
# DIANE_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Agent V2 / Diane
# -----------------------------------------------------------------------------

# DIANE_CHAT_V2_AGENT_BACKEND=super_dan
# DIANE_CHAT_V2_AGENT_MODEL=gpt-5.4
# DIANE_CHAT_V2_AGENT_BASE_URL=https://api.openai.com/v1
# DIANE_CHAT_V2_SCHEDULER_SOFT_BUDGET=1
# DIANE_CHAT_V2_SCHEDULER_BUDGET_MAX_LEASES=4
# DIANE_CHAT_V2_SCHEDULER_BUDGET_MAX_EXTRA_CONTINUATIONS=4

# Optional Codex execution backend retained by the Agent V2 adapter.
# DIANE_CODEX_BIN=codex
# DIANE_CODEX_MODEL=
# DIANE_CODEX_REASONING_EFFORT=high
# DIANE_CODEX_SANDBOX=workspace-write
# DIANE_CODEX_AUTO_CONTINUATION_MAX=4

# -----------------------------------------------------------------------------
# Tools and safety
# -----------------------------------------------------------------------------

# Relative file paths are resolved under DIANE_WORKSPACE_ROOT.
# DIANE_STRICT_SANDBOX=1

# shell_command uses the operational subprocess guardrail by default.
# This is not an OS security sandbox.
# DIANE_SANDBOX_SHELL=1
# DIANE_SANDBOX_TIMEOUT=30
# DIANE_SANDBOX_MEMORY_MB=512
# DIANE_SHELL_ALLOW=python -m pytest,npm test,npm run build

# GUI browser sessions open lazily: visible on desktop, headless without a display.
# pip install -e '.[browser]' (uses installed Chrome if managed Chromium is absent).
# DIANE_BROWSER_HEADLESS=auto
# Profile applies to standalone tools; GUI chats use isolated per-run sessions.
# DIANE_BROWSER_PROFILE=default
# DIANE_BROWSER_EXECUTABLE=
# DIANE_BROWSER_DISABLE_KEYCHAIN=1
# DIANE_COMPUTER_CONTROL=0

# Web search provider order; DuckDuckGo can be used as a no-key fallback when installed.
# DIANE_TAVILY_API_KEY=
# DIANE_SERPER_API_KEY=
# DIANE_BRAVE_API_KEY=
# DIANE_SEARCH_PROVIDER_ORDER=tavily,serper,brave,ddg
# DIANE_SEARCH_BLOCKED_DOMAINS=
# DIANE_SEARCH_COUNTRY=
# DIANE_SEARCH_LANGUAGE=
# DIANE_WEB_SEARCH_FETCH_CONCURRENCY=4

# Optional media/provider helpers.
# DIANE_OPENAI_API_KEY=
# DIANE_OPENAI_BASE_URL=https://api.openai.com/v1
# DIANE_WHISPER_API_KEY=
# DIANE_WHISPER_BASE_URL=https://api.openai.com/v1
# DIANE_WHISPER_MODEL=whisper-1

# Optional notification webhook.
# DIANE_NOTIFY_WEBHOOK_URL=
# DIANE_NOTIFY_WEBHOOK_HEADERS={"Authorization":"Bearer ..."}

# Optional email tool.
# DIANE_SMTP_HOST=smtp.example.com
# DIANE_SMTP_PORT=587
# DIANE_SMTP_USER=
# DIANE_SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Skills and phone connectivity
# -----------------------------------------------------------------------------

# DIANE_AUTO_EXTERNAL_SKILLS=1
# DIANE_EXTERNAL_SKILLS_DIRS=/path/one:/path/two
# DIANE_USER_HOME=/custom/home

# Read-only WireGuard status and bind selection.
# DIANE_PHONE_WIREGUARD_HOST=10.77.77.2
# DIANE_UP_HOST=auto
# DIANE_WIREGUARD_MANAGED_MODE=auto
# DIANE_ALIAS_NYWG_CONFIG=~/.config/wireguard/nywg.conf
