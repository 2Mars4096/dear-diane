# Deep Agent Network — environment variables
# Copy this file to .env and fill in your values.

## Quick Profiles (uncomment one line to activate a bundle)
# DAN_LEARNING_MODE=1      # Turn on all safe learning features
# DAN_FULL_TOOLS=1         # Expose all 32+ tools in chat
# DAN_ENABLE_TIER_POLICY=1 # Auto-assign models by task difficulty

# -----------------------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------------------
# Default LLM provider (OpenAI-compatible endpoint — used for all models by default)
DAN_LLM_API_KEY=your-api-key-here
DAN_LLM_BASE_URL=https://api.vectorengine.ai/v1
DAN_LLM_MODEL=claude-sonnet-4-6        # execution default model (nodes, engine)

# Chat-specific model override (falls back to DAN_LLM_MODEL)
# DAN_CHAT_MODEL=claude-sonnet-4-6

# Intent classifier model (micro-tier, auto-resolved if unset)
# DAN_CLASSIFIER_MODEL=gpt-4o-mini

# Native provider keys (optional — enables direct API access for each provider)
# When set, models matching the provider prefix route to the native API
# (e.g. gpt-* → OpenAI, claude-* → Anthropic, gemini-* → Google)
# DAN_OPENAI_API_KEY=
# DAN_ANTHROPIC_API_KEY=
# DAN_GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# Model Tiering
# -----------------------------------------------------------------------------
# Auto-assign models based on task difficulty (defaults to off)
# DAN_ENABLE_TIER_POLICY=1
# JSON map of tier levels to models
# DAN_TIER_MAP={"1": "gpt-4o-mini", "2": "claude-sonnet-4-6", "3": "claude-opus-4-6"}

# -----------------------------------------------------------------------------
# Learning & Evolvement
# -----------------------------------------------------------------------------
# Learning tier controls which learning features are active (default: 0):
#   0 = baseline: memory, post-run learning, reuse scoring, preference evolution
#   1 = advisory: + topology suggestions, model recommendations, prompt proposals
#   2 = active:   + A/B prompt promotion, skill refinement, auto-adaptation
# DAN_LEARNING_TIER=0

# Legacy bundle toggle (DAN_LEARNING_MODE=1 maps to tier 1)
# DAN_LEARNING_MODE=1

# Individual feature overrides — force-enable (1) or force-disable (0)
# regardless of tier. Useful for enabling specific features without
# upgrading the entire tier.
# DAN_PROMPT_OPTIMIZATION=1
# DAN_MODEL_LEARNING=1
# DAN_TOPOLOGY_LEARNING=1
# DAN_SKILL_LEARNING=1

# Memory extraction settings
# DAN_MEMORY_EXTRACTION=1
# DAN_MEMORY_EXTRACTION_LLM=claude-sonnet-4-6
# DAN_MEMORY_DUAL_WRITE=1

# -----------------------------------------------------------------------------
# Concierge Behavior
# -----------------------------------------------------------------------------
# Autonomy level: auto, manual, or strict (defaults to auto)
# DAN_CONCIERGE_AUTONOMY=auto
# Time before showing "I'm thinking" messages (seconds)
# DAN_CONCIERGE_REASSURANCE_DELAY=2.0
# Interval between "I'm still thinking" messages (seconds)
# DAN_CONCIERGE_REASSURANCE_INTERVAL=5.0
# Enable parallel prep for capabilities
# DAN_CONCIERGE_PARALLEL_PREP=1
# Timeout for parallel prep (seconds)
# DAN_CONCIERGE_PREP_TIMEOUT=10.0

# -----------------------------------------------------------------------------
# Identity & Display
# -----------------------------------------------------------------------------
# Change the name shown in reply prefixes like [DAN - Project]
# DAN_BOT_NAME=DAN
# Show cost metrics in the UI and terminal
# DAN_SHOW_COST=1

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
# Terminal bell on specific events
# DAN_NOTIFY_BELL=1
# Webhook URL for external notifications
# DAN_NOTIFY_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Cost & Safety
# -----------------------------------------------------------------------------
# Ask for confirmation if a run exceeds this cost threshold ($)
# DAN_COST_CONFIRM_THRESHOLD=0.50
# Ask for confirmation before applying graph mutations (defaults to 0 in chat, can use --confirm)
# DAN_MUTATION_CONFIRM=0
# Enable PII tokenization — replaces sensitive words with semantic placeholders before LLM calls
# DAN_PII_PROTECTION=0

# Telemetry — unified tracking of all chat turns, workflow runs, guards, etc.
# DAN_TELEMETRY=1                              # Enable telemetry (on by default)
# DAN_TELEMETRY_DB=~/.dan/telemetry.db         # SQLite DB path
# DAN_TELEMETRY_RETENTION_DAYS=90              # Auto-prune events older than N days

# -----------------------------------------------------------------------------
# MCP Servers
# -----------------------------------------------------------------------------
# Path to MCP server configuration (defaults to ~/.dan/mcp.json)
# DAN_MCP_CONFIG=~/.dan/mcp.json

# -----------------------------------------------------------------------------
# Skills
# -----------------------------------------------------------------------------
# Skills are SKILL.md files (IDE-compatible format) scanned from these dirs:
#   1. ~/.dan/skills/<name>/SKILL.md       (user-level, cross-project)
#   2. .dan/skills/<name>/SKILL.md         (project-level)
#   3. DAN_CUSTOM_SKILLS_DIR               (legacy flat .md files)
# Import from Cursor/Claude/Codex: /skill import ~/.cursor/skills/my-skill
# DAN_CUSTOM_SKILLS_DIR=custom_skills
# DAN_PROJECT_SKILLS_DIR=.dan/skills

# -----------------------------------------------------------------------------
# Tools
# -----------------------------------------------------------------------------
# Expose the full suite of 32+ tools in chat (defaults to 0, which shows only the basic set)
# DAN_FULL_TOOLS=1

# Workspace root for file operations (defaults to current directory)
# DAN_WORKSPACE_ROOT=.
# Path to Stata executable for stata tool
# DAN_STATA_PATH=
# Voice transcription (OpenAI-compatible Whisper endpoint)
# DAN_WHISPER_API_KEY=
# DAN_WHISPER_BASE_URL=https://api.openai.com/v1
# DAN_WHISPER_MODEL=whisper-1

# Web search — provider cascade: Tavily → Brave → DuckDuckGo (fallback)
# DAN_TAVILY_API_KEY=
# DAN_BRAVE_API_KEY=

# Email sending (for send_email capability tool)
# DAN_SMTP_HOST=smtp.gmail.com
# DAN_SMTP_PORT=587
# DAN_SMTP_USER=
# DAN_SMTP_PASSWORD=
# DAN_SMTP_FROM_NAME=DAN

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# Model used for RAG, semantic cache, self-knowledge index, etc.
# DAN_DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Separate API credentials for embeddings (falls back to DAN_LLM_API_KEY / DAN_LLM_BASE_URL)
# DAN_EMBEDDING_API_KEY=
# DAN_EMBEDDING_BASE_URL=

# Local embeddings via sentence-transformers (zero API cost, runs on CPU)
# DAN_ENABLE_LOCAL_EMBEDDINGS=0
# DAN_LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Service & Performance
# -----------------------------------------------------------------------------
# Data directory (defaults to ./graphs, ~/.dan, etc)
# DAN_DATA_DIR=
# Checkpointing directory
# DAN_CHECKPOINT_DIR=./checkpoints
# Server log level
# DAN_LOG_LEVEL=INFO
# Evolvement loop log level
# DAN_EVOLVEMENT_LOG_LEVEL=INFO
# Max concurrent LLM calls across the system
# DAN_MAX_CONCURRENT_LLM=10
# Max concurrent workflow runs
# DAN_MAX_CONCURRENT_RUNS=5
# Max memory usage threshold (MB) before pausing/rejecting runs
# DAN_MAX_MEMORY_MB=2048
