# Deep Agent Network — environment variables
# Copy this file to .env and fill in your values.

# Default LLM provider (OpenAI-compatible endpoint — used for all models by default)
DAN_LLM_API_KEY=your-api-key-here
DAN_LLM_BASE_URL=https://api.vectorengine.ai/v1
DAN_LLM_MODEL=claude-sonnet-4-6        # execution default model (nodes, engine)
# DAN_CHAT_MODEL=claude-sonnet-4-6     # chat-specific override (falls back to DAN_LLM_MODEL)

# Native provider keys (optional — enables direct API access for each provider)
# When set, models matching the provider prefix route to the native API
# (e.g. gpt-* → OpenAI, claude-* → Anthropic, gemini-* → Google)
DAN_OPENAI_API_KEY=
DAN_ANTHROPIC_API_KEY=
DAN_GOOGLE_API_KEY=

# Web search — provider cascade: Tavily → Brave → DuckDuckGo (fallback)
# Set at least one key. First available wins. Falls back to DDG scraping when none set.
# Tavily (recommended, built for LLM agents): https://app.tavily.com
DAN_TAVILY_API_KEY=
# Brave Search: https://api.search.brave.com/register
DAN_BRAVE_API_KEY=

# Email sending (for send_email capability tool)
# Gmail: host=smtp.gmail.com, port=587, use app password (not regular password)
# https://myaccount.google.com/apppasswords
DAN_SMTP_HOST=
DAN_SMTP_PORT=587
DAN_SMTP_USER=
DAN_SMTP_PASSWORD=
DAN_SMTP_FROM_NAME=DAN

# Bot identity (optional — change the name shown in reply prefixes like [DAN - Project])
# DAN_BOT_NAME=DAN

# Checkpointing
DAN_CHECKPOINT_DIR=./checkpoints
