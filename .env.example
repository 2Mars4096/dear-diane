# Deep Agent Network — retained Universal product configuration
# Copy to .env and uncomment only what you need.

# -----------------------------------------------------------------------------
# Provider
# -----------------------------------------------------------------------------

DAN_LLM_API_KEY=your-api-key-here
DAN_LLM_BASE_URL=https://api.openai.com/v1
DAN_LLM_MODEL=gpt-5.4

# Token usage analyzer (DAN settings): stage classifier on OpenRouter's Decisions endpoint.
# Uses DAN_OPENROUTER_API_KEY, OPENROUTER_API_KEY, or DAN_LLM_API_KEY. Default: jev-latest
# DAN_USAGE_CLASSIFIER_MODEL=jev-latest

# Native-provider keys for matching model prefixes.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# DAN_ANTHROPIC_API_KEY=
# DAN_GOOGLE_API_KEY=

# Exact model-to-provider overrides, for example:
# DAN_MODEL_PROVIDER_MAP={"custom-model":"default","claude-custom":"anthropic"}

# Provider request behavior.
# DAN_PROVIDER_TIMEOUT=120
# DAN_LLM_CALL_TIMEOUT=120
# DAN_PROVIDER_RETRY_MAX_ATTEMPTS=3
# DAN_PROVIDER_RETRY_INITIAL_DELAY_SECONDS=1
# DAN_PROVIDER_RETRY_MAX_DELAY_SECONDS=8
# DAN_OPENAI_COMPAT_REASONING=enabled

# -----------------------------------------------------------------------------
# Workspace and durable state
# -----------------------------------------------------------------------------

# DAN_WORKSPACE_ROOT=/absolute/path/to/workspace
# DAN_GRAPHS_DIR=/absolute/path/to/durable-state
# DAN_NOTES_WORKSPACE_ROOT=/absolute/path/to/notes
# DAN_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Agent V2 / Super DAN
# -----------------------------------------------------------------------------

# DAN_CHAT_V2_AGENT_BACKEND=super_dan
# DAN_CHAT_V2_AGENT_MODEL=gpt-5.4
# DAN_CHAT_V2_AGENT_BASE_URL=https://api.openai.com/v1
# DAN_CHAT_V2_SCHEDULER_SOFT_BUDGET=1
# DAN_CHAT_V2_SCHEDULER_BUDGET_MAX_LEASES=4
# DAN_CHAT_V2_SCHEDULER_BUDGET_MAX_EXTRA_CONTINUATIONS=4

# Optional Codex execution backend retained by the Agent V2 adapter.
# DAN_CODEX_BIN=codex
# DAN_CODEX_MODEL=
# DAN_CODEX_REASONING_EFFORT=high
# DAN_CODEX_SANDBOX=workspace-write
# DAN_CODEX_AUTO_CONTINUATION_MAX=4

# -----------------------------------------------------------------------------
# Tools and safety
# -----------------------------------------------------------------------------

# Relative file paths are resolved under DAN_WORKSPACE_ROOT.
# DAN_STRICT_SANDBOX=1

# shell_command uses the operational subprocess guardrail by default.
# This is not an OS security sandbox.
# DAN_SANDBOX_SHELL=1
# DAN_SANDBOX_TIMEOUT=30
# DAN_SANDBOX_MEMORY_MB=512
# DAN_SHELL_ALLOW=python -m pytest,npm test,npm run build

# GUI browser sessions open lazily: visible on desktop, headless without a display.
# pip install -e '.[browser]' (uses installed Chrome if managed Chromium is absent).
# DAN_BROWSER_HEADLESS=auto
# Profile applies to standalone tools; GUI chats use isolated per-run sessions.
# DAN_BROWSER_PROFILE=default
# DAN_BROWSER_EXECUTABLE=
# DAN_BROWSER_DISABLE_KEYCHAIN=1
# DAN_COMPUTER_CONTROL=0

# Web search provider order; DuckDuckGo can be used as a no-key fallback when installed.
# DAN_TAVILY_API_KEY=
# DAN_SERPER_API_KEY=
# DAN_BRAVE_API_KEY=
# DAN_SEARCH_PROVIDER_ORDER=tavily,serper,brave,ddg
# DAN_SEARCH_BLOCKED_DOMAINS=
# DAN_SEARCH_COUNTRY=
# DAN_SEARCH_LANGUAGE=
# DAN_WEB_SEARCH_FETCH_CONCURRENCY=4

# Optional media/provider helpers.
# DAN_OPENAI_API_KEY=
# DAN_OPENAI_BASE_URL=https://api.openai.com/v1
# DAN_WHISPER_API_KEY=
# DAN_WHISPER_BASE_URL=https://api.openai.com/v1
# DAN_WHISPER_MODEL=whisper-1

# Optional notification webhook.
# DAN_NOTIFY_WEBHOOK_URL=
# DAN_NOTIFY_WEBHOOK_HEADERS={"Authorization":"Bearer ..."}

# Optional email tool.
# DAN_SMTP_HOST=smtp.example.com
# DAN_SMTP_PORT=587
# DAN_SMTP_USER=
# DAN_SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Skills and phone connectivity
# -----------------------------------------------------------------------------

# DAN_AUTO_EXTERNAL_SKILLS=1
# DAN_EXTERNAL_SKILLS_DIRS=/path/one:/path/two
# DAN_USER_HOME=/custom/home

# Read-only WireGuard status and bind selection.
# DAN_PHONE_WIREGUARD_HOST=10.77.77.2
# DAN_UP_HOST=auto
# DAN_WIREGUARD_MANAGED_MODE=auto
# DAN_ALIAS_NYWG_CONFIG=~/.config/wireguard/nywg.conf
