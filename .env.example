# Deep Agent Network — environment variables
# Copy this file to .env and fill in your values.
# IMPORTANT:
# - You do NOT need every variable in this file.
# - Most entries below are optional overrides or feature-specific credentials.
# - For a basic setup, configure one LLM path in the "LLM Provider" section
#   and leave the rest commented out.

## Quick Profiles
# Full tools is ON by default — all 32+ built-in tools are available in chat.
# Set DAN_FULL_TOOLS=0 to restrict to the minimal set.
DAN_FULL_TOOLS=1

# Learning mode: enables advisory learning features (topology suggestions,
# model recommendations, prompt proposals). Safe to turn on — nothing is
# auto-applied without your approval.  Recommended for power users.
# DAN_LEARNING_MODE=1

# Tier policy: auto-assigns cheap/fast models for simple tasks and reserves
# powerful models for complex ones.  Requires DAN_TIER_MAP to be set (see
# "Model Tiering" section below).  Recommended once you have multiple models.
# DAN_ENABLE_TIER_POLICY=1

# -----------------------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------------------
# You only need ONE baseline provider path for chat/execution:
#   1. Generic OpenAI-compatible provider (recommended for VectorEngine,
#      OpenRouter, Moonshot/Kimi, local gateways, or any compatible API):
#      set DAN_LLM_API_KEY + DAN_LLM_BASE_URL + DAN_LLM_MODEL
#   2. Native provider access (optional):
#      set only the matching native key below and make DAN_LLM_MODEL use
#      that provider's model family
#
# REQUIRED for the generic OpenAI-compatible path above.
DAN_LLM_API_KEY=your-api-key-here
DAN_LLM_BASE_URL=https://api.vectorengine.ai/v1
# REQUIRED for a reliable single-provider setup: pick a model your
# configured provider can actually serve.
DAN_LLM_MODEL=claude-sonnet-4-6        # execution default model (nodes, engine)

# OPTIONAL chat-specific model override (falls back to DAN_LLM_MODEL)
# DAN_CHAT_MODEL=claude-sonnet-4-6

# OPTIONAL intent classifier override (auto-resolved if unset)
# DAN_CLASSIFIER_MODEL=gpt-4o-mini

# OPTIONAL native provider keys — set only the providers you actually use.
# If these stay unset, DAN keeps using the generic DAN_LLM_* path above.
# Anthropic-only example: set DAN_ANTHROPIC_API_KEY + DAN_LLM_MODEL=claude-...
# OpenAI-only example: set DAN_OPENAI_API_KEY + DAN_LLM_MODEL=gpt-... or o...
# Moonshot/Kimi/OpenRouter users should usually use DAN_LLM_API_KEY +
# DAN_LLM_BASE_URL instead.
# DAN_OPENAI_API_KEY=
# DAN_ANTHROPIC_API_KEY=
# DAN_GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# Model Tiering
# -----------------------------------------------------------------------------
# OPTIONAL. Leave this off unless you want automatic per-task model selection.
# If DAN_ENABLE_TIER_POLICY=1, DAN_TIER_MAP becomes effectively required.
# Single-provider OpenAI-compatible setups (Moonshot/Kimi/OpenRouter/etc.)
# should set DAN_TIER_MAP explicitly.
# Auto-assign models based on task difficulty (defaults to off)
# DAN_ENABLE_TIER_POLICY=1

# Tier-to-model mapping (JSON). Supports canonical named tiers or numeric shorthand.
# Named tiers: micro, routine, reasoning, critical
# Numeric shorthand: 1=micro, 2=routine, 3=reasoning+critical
# Used by both the workflow engine (TierPolicy) and concierge stage-based routing.
# Examples:
#   DAN_TIER_MAP={"micro":"gpt-4o-mini","routine":"gpt-4o","reasoning":"o3-mini","critical":"o3"}
#   DAN_TIER_MAP={"1":"gpt-4o-mini","2":"gpt-4o","3":"o3-mini"}
# DAN_TIER_MAP=

# -----------------------------------------------------------------------------
# Learning & Evolvement
# -----------------------------------------------------------------------------
# OPTIONAL feature toggles. Safe to leave commented out.
# Learning tier controls which learning features are active (default: 0):
#   0 = baseline: memory, post-run learning, reuse scoring, preference evolution
#   1 = advisory: + topology suggestions, model recommendations, prompt proposals
#   2 = active:   + A/B prompt promotion, skill refinement, auto-adaptation
# DAN_LEARNING_TIER=0

# Legacy bundle toggle (DAN_LEARNING_MODE=1 maps to tier 1)
# DAN_LEARNING_MODE=1

# Individual feature overrides — force-enable (1) or force-disable (0)
# regardless of tier. Useful for enabling specific features without
# upgrading the entire tier.
# DAN_PROMPT_OPTIMIZATION=1
# DAN_MODEL_LEARNING=1
# DAN_TOPOLOGY_LEARNING=1
# DAN_SKILL_LEARNING=1

# Memory extraction settings
# DAN_MEMORY_EXTRACTION=1
# DAN_DOMAIN_LEARNING=1           # Enable domain knowledge extraction from completed tasks (tier 1)
# DAN_DOMAIN_VALIDATION=1         # Enable domain-aware post-generation validation (tier 1)
# DAN_DOMAIN_TEMPLATE_UPGRADE=1   # Enable LLM-assisted domain template upgrades (tier 2)
# DAN_MEMORY_EXTRACTION_LLM=claude-sonnet-4-6
# DAN_MEMORY_DUAL_WRITE=1

# Self-Adaptive Behavior (31-22)
# DAN_PARAM_TRACKING=1           # Enable parameter-outcome tracking (tier 0 default)
# DAN_THRESHOLD_PROPOSAL=1       # Enable threshold proposals (tier 1)
# DAN_THRESHOLD_CALIBRATION=1    # Enable auto-calibration (tier 2)
# DAN_PROMPT_PROPOSAL=1          # Enable prompt variant proposals (tier 1)
# DAN_PROMPT_SELECTION=1         # Enable prompt selection (tier 2)
# DAN_INTENT_DISCOVERY=1         # Enable intent discovery proposals (tier 1)
# DAN_DOMAIN_DISCOVERY=1         # Enable domain discovery proposals (tier 1)
# DAN_MODEL_TIER_PROPOSAL=1      # Enable model tier proposals (tier 1)

# -----------------------------------------------------------------------------
# Concierge Behavior
# -----------------------------------------------------------------------------
# OPTIONAL overrides. Defaults are used if these stay commented out.
# Autonomy level: auto, manual, or strict (defaults to auto)
# DAN_CONCIERGE_AUTONOMY=auto
# Time before showing "I'm thinking" messages (seconds)
# DAN_CONCIERGE_REASSURANCE_DELAY=3.0
# Interval between "I'm still thinking" messages (seconds)
# DAN_CONCIERGE_REASSURANCE_INTERVAL=5.0
# Enable parallel prep for capabilities
# DAN_CONCIERGE_PARALLEL_PREP=1
# Timeout for parallel prep (seconds)
# DAN_CONCIERGE_PREP_TIMEOUT=10.0
# DAN_AUTO_READ=1                 # Auto-read referenced files before processing (default: on)
# DAN_PARALLEL_TASK_LIMIT=8       # Max concurrent blocking calls across all fan-outs

# -----------------------------------------------------------------------------
# Identity & Display
# -----------------------------------------------------------------------------
# OPTIONAL display overrides.
# Change the name shown in reply prefixes like [DAN - Project]
# DAN_BOT_NAME=DAN
# Show cost metrics in the UI and terminal
# DAN_SHOW_COST=1

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
# OPTIONAL notification settings.
# Terminal bell on specific events
# DAN_NOTIFY_BELL=1
# Webhook URL for external notifications
# DAN_NOTIFY_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Cost & Safety
# -----------------------------------------------------------------------------
# OPTIONAL safety and cost overrides.
# Ask for confirmation if a run exceeds this cost threshold ($)
# DAN_COST_CONFIRM_THRESHOLD=0.50
# Ask for confirmation before applying graph mutations (defaults to 0 in chat, can use --confirm)
# DAN_MUTATION_CONFIRM=0
# Enable PII tokenization — replaces sensitive words with semantic placeholders before LLM calls
# DAN_PII_PROTECTION=0

# Telemetry — unified tracking of all chat turns, workflow runs, guards, etc.
# DAN_TELEMETRY=1                              # Enable telemetry (on by default)
# DAN_TELEMETRY_DB=~/.dan/telemetry.db         # SQLite DB path
# DAN_TELEMETRY_RETENTION_DAYS=90              # Auto-prune events older than N days

# -----------------------------------------------------------------------------
# MCP Servers
# -----------------------------------------------------------------------------
# OPTIONAL override for MCP server discovery.
# Path to MCP server configuration (defaults to ~/.dan/mcp.json)
# DAN_MCP_CONFIG=~/.dan/mcp.json

# -----------------------------------------------------------------------------
# Skills
# -----------------------------------------------------------------------------
# OPTIONAL skill-discovery overrides.
# Skills are SKILL.md files (IDE-compatible format) scanned from these dirs:
#   1. ~/.dan/skills/<name>/SKILL.md       (user-level, cross-project)
#   2. .dan/skills/<name>/SKILL.md         (project-level)
#   3. DAN_CUSTOM_SKILLS_DIR               (legacy flat .md files)
# Import from Cursor/Claude/Codex: /skill import ~/.cursor/skills/my-skill
# DAN_CUSTOM_SKILLS_DIR=custom_skills
# DAN_PROJECT_SKILLS_DIR=.dan/skills

# -----------------------------------------------------------------------------
# Tools
# -----------------------------------------------------------------------------
# OPTIONAL tool-specific settings. Set only the keys for tools you plan to use.
# Expose the full suite of 32+ tools in chat (defaults to 0, which shows only the basic set)
# DAN_FULL_TOOLS=1

# Workspace root for file operations (defaults to current directory)
# DAN_WORKSPACE_ROOT=.
# Path to Stata executable for stata tool (optional; only needed for `stata`)
# DAN_STATA_PATH=
# Voice transcription (optional; only needed for audio/voice transcription)
# DAN_WHISPER_API_KEY=
# DAN_WHISPER_BASE_URL=https://api.openai.com/v1
# DAN_WHISPER_MODEL=whisper-1

# Web search (optional) — provider cascade: Tavily → Brave → DuckDuckGo (fallback)
# DAN_TAVILY_API_KEY=
# DAN_BRAVE_API_KEY=

# Email sending (optional; only needed for `send_email`)
# DAN_SMTP_HOST=smtp.gmail.com
# DAN_SMTP_PORT=587
# DAN_SMTP_USER=
# DAN_SMTP_PASSWORD=
# DAN_SMTP_FROM_NAME=DAN

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# OPTIONAL embedding overrides. If unset, DAN falls back to DAN_LLM_* where possible.
# Model used for RAG, semantic cache, self-knowledge index, etc.
# DAN_DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Separate API credentials for embeddings (falls back to DAN_LLM_API_KEY / DAN_LLM_BASE_URL)
# DAN_EMBEDDING_API_KEY=
# DAN_EMBEDDING_BASE_URL=

# Local embeddings via sentence-transformers (zero API cost, runs on CPU)
# DAN_ENABLE_LOCAL_EMBEDDINGS=0
# DAN_LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Service & Performance
# -----------------------------------------------------------------------------
# OPTIONAL runtime/performance overrides.
# Data directory (defaults to ./graphs, ~/.dan, etc)
# DAN_DATA_DIR=
# Checkpointing directory
# DAN_CHECKPOINT_DIR=./checkpoints
# Server log level
# DAN_LOG_LEVEL=INFO
# Evolvement loop log level
# DAN_EVOLVEMENT_LOG_LEVEL=INFO
# Max concurrent LLM calls across the system
# DAN_MAX_CONCURRENT_LLM=10
# Max concurrent workflow runs
# DAN_MAX_CONCURRENT_RUNS=5
# Max memory usage threshold (MB) before pausing/rejecting runs
# DAN_MAX_MEMORY_MB=2048
